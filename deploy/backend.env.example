# CurrentMusic backend environment (example)
# Copy to /etc/currentmusic/backend.env and chmod 600; never commit real secrets.
CM_PORT=3010
CM_DATA_DIR=/var/lib/currentmusic
CM_DB=/var/lib/currentmusic/cm.db
CM_AVATAR_DIR=/var/lib/currentmusic/avatars
CM_RELEASES_DIR=/var/lib/currentmusic/releases
CM_X_RELEASES_DIR=/var/lib/currentmusic/releases-x
CM_DEFAULT_HOST=music.example.com
# Explicit HTTPS origins for self-hosted passkey registration/login. No wildcards.
CM_PASSKEY_ORIGINS=https://music.example.com

# NetEase API enhanced instance and its cookie file.
CM_NCM_BASE=http://127.0.0.1:3001
CM_NCM_COOKIE=/etc/currentmusic/ncm-cookie
# Optional single source for /song/url/match; empty uses the upstream's automatic selection.
# CM_NCM_MATCH_SOURCE=unm
# Optional public album metadata index, maintained with tools/update-search-catalog.py.
# CM_SEARCH_CATALOG=/srv/currentmusic/data/search-catalog.json

# Optional AI assistant (DeepSeek).
# CM_AI_KEY=
# CM_AI_BASE=https://api.deepseek.com/v1
# CM_AI_MODEL=deepseek-flash
# CM_AI_EFFORT=high

# Optional email codes (register / login / email binding / password reset).
# CM_SMTP_HOST=smtp.example.com
# CM_SMTP_PORT=465
# CM_SMTP_USER=
# CM_SMTP_PASS=
# CM_SMTP_FROM=

# Optional SMS webhook.
# CM_SMS_WEBHOOK=
# CM_SMS_TOKEN=
# CM_SMS_SIGN=CurrentMusic

# Optional cast/share directories.
# CM_CAST_CACHE=/var/lib/currentmusic/cast
# CM_SHARE_DIR=/var/lib/currentmusic/share

# Optional LDDC word-by-word lyrics fallback (separate GPL-3.0 service).
# Install with deploy/install-lddc.sh; it writes these into a systemd drop-in.
# CM_LDDC_URL=http://127.0.0.1:3015
# CM_LDDC_TOKEN=
# CM_LDDC_TIMEOUT=7
# CM_LDDC_RETRY_TTL=7200

