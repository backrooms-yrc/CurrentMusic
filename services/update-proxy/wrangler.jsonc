{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "currentmusic-updates",
  "main": "src/worker.js",
  "account_id": "72a9a4aec5bb13aa907c33f9a0bfb711",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "updates.bileizhen.top", "custom_domain": true }],
  "vars": { "APP_KEY_ID": "update-v1" },
  "durable_objects": { "bindings": [{ "name": "REQUEST_GUARD", "class_name": "RequestGuard" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RequestGuard"] }],
  "observability": { "enabled": false }
}
