<Window x:Class="CurrentMusic.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CurrentMusic for Windows">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <NavigationView x:Name="Navigation" PaneTitle="CurrentMusic" PaneDisplayMode="Auto" IsBackButtonVisible="Collapsed" IsSettingsVisible="True" SelectionChanged="Navigation_SelectionChanged" AlwaysShowHeader="False">
   <NavigationView.MenuItems>
    <NavigationViewItem Content="为你推荐" Tag="home" Icon="Home"/>
    <NavigationViewItem Content="搜索" Tag="search" Icon="Find"/>
    <NavigationViewItem Content="我的音乐" Tag="library" Icon="Library"/>
    <NavigationViewItem Content="播放队列" Tag="queue" Icon="List"/>
    <NavigationViewItem Content="正在播放" Tag="player" Icon="MusicInfo"/>
    <NavigationViewItem Content="账号" Tag="account" Icon="Contact"/>
   </NavigationView.MenuItems>
   <Grid Padding="24" RowSpacing="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="PageTitle" Text="为你推荐" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap"/>
     <Button Grid.Column="1" x:Name="AccountButton" Content="登录" Click="Account_Click"/>
    </Grid>
    <StackPanel Grid.Row="1" Spacing="10">
     <Grid x:Name="SearchPanel" Visibility="Collapsed" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <AutoSuggestBox x:Name="QueryBox" PlaceholderText="搜索歌曲、歌手、专辑、歌单" QueryIcon="Find" QuerySubmitted="Query_Submitted"/>
      <ComboBox Grid.Column="1" x:Name="SearchType" SelectedIndex="0" AutomationProperties.Name="搜索类型"><ComboBoxItem Content="歌曲"/><ComboBoxItem Content="歌手"/><ComboBoxItem Content="专辑"/><ComboBoxItem Content="歌单"/></ComboBox>
      <Button Grid.Column="2" Content="搜索" Click="Search_Click"/>
     </Grid>
     <StackPanel x:Name="HomeToolbar" Orientation="Horizontal" Spacing="8">
      <Button Content="每日推荐" Click="Daily_Click"/><Button Content="猜你喜欢" Click="ForYou_Click"/>
      <ComboBox x:Name="RoamingMode" SelectedIndex="0" AutomationProperties.Name="漫游模式"><ComboBoxItem Content="默认漫游"/><ComboBoxItem Content="熟悉"/><ComboBoxItem Content="探索"/><ComboBoxItem Content="放松"/><ComboBoxItem Content="专注"/></ComboBox>
      <Button Content="私人漫游 · 换一批" Click="Roaming_Click"/>
     </StackPanel>
     <StackPanel x:Name="LibraryToolbar" Visibility="Collapsed" Orientation="Horizontal" Spacing="8">
      <ComboBox x:Name="LibraryType" SelectedIndex="0" AutomationProperties.Name="音乐库分类"><ComboBoxItem Content="我喜欢"/><ComboBoxItem Content="收藏快照"/><ComboBoxItem Content="最近播放"/><ComboBoxItem Content="我的歌单"/></ComboBox>
      <Button Content="刷新" Click="Library_Click"/><Button Content="新建歌单" Click="CreatePlaylist_Click"/>
     </StackPanel>
     <TextBlock x:Name="PageDescription" MaxLines="3" TextTrimming="CharacterEllipsis" Text="发现好音乐，开始今天的聆听。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <StackPanel x:Name="TrackToolbar" Orientation="Horizontal" Spacing="8">
      <Button Content="播放全部" Click="PlayAll_Click"/><Button Content="播放选中" Click="PlaySelected_Click"/><Button Content="加入队列" Click="Enqueue_Click"/>
      <Button Content="喜欢 / 取消" Click="Like_Click"/><Button Content="加入歌单" Click="AddToPlaylist_Click"/>
     </StackPanel>
     <StackPanel x:Name="PlaylistToolbar" Visibility="Collapsed" Orientation="Horizontal" Spacing="8">
      <Button Content="重命名歌单" Click="RenamePlaylist_Click"/><Button Content="从歌单移除选中" Click="RemoveTrack_Click"/><Button Content="删除歌单" Click="DeletePlaylist_Click"/>
     </StackPanel>
    </StackPanel>
    <Grid Grid.Row="2">
     <Grid x:Name="ResultsPanel" RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ListView x:Name="Results" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Results_ItemClick" KeyDown="Results_KeyDown" AutomationProperties.Name="音乐列表">
       <ListView.ItemTemplate><DataTemplate>
        <Grid Padding="8" ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Border CornerRadius="6" Width="48" Height="48" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><Image Source="{Binding Picture}" Stretch="UniformToFill"/></Border>
         <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
         <TextBlock Grid.Column="2" Text="{Binding Badge}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>
       </DataTemplate></ListView.ItemTemplate>
      </ListView>
      <Button Grid.Row="1" x:Name="LoadMore" Content="加载更多" Visibility="Collapsed" HorizontalAlignment="Center" Click="More_Click"/>
     </Grid>
     <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed"><StackPanel Spacing="18" MaxWidth="700" HorizontalAlignment="Left">
      <ComboBox x:Name="ThemePicker" Header="应用主题" SelectionChanged="ThemePicker_SelectionChanged" MinWidth="240"><ComboBoxItem Content="跟随系统"/><ComboBoxItem Content="浅色"/><ComboBoxItem Content="深色"/></ComboBox>
      <TextBox x:Name="ApiBaseBox" Header="HTTPS API 服务地址（包含 /cm）" MinWidth="320"/>
      <ComboBox x:Name="QualityPicker" Header="音质（下次播放生效）" MinWidth="240"><ComboBoxItem Content="无损 FLAC"/><ComboBoxItem Content="自动最高"/><ComboBoxItem Content="极高 320k"/><ComboBoxItem Content="标准 128k"/><ComboBoxItem Content="高清臻音"/><ComboBoxItem Content="臻音全景声"/><ComboBoxItem Content="超清母带"/><ComboBoxItem Content="沉浸环绕声"/></ComboBox>
      <CheckBox x:Name="TrayOption" Content="关闭主窗口时留在托盘继续播放"/>
      <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="保存设置" Click="SaveSettings_Click"/><Button Content="检测连接" Click="Probe_Click"/></StackPanel>
      <TextBlock Text="快捷键：Ctrl+空格 播放/暂停；Ctrl+←/→ 切歌；Ctrl+F 搜索。系统媒体键也可控制播放。" TextWrapping="Wrap"/>
      <TextBlock Text="CurrentMusic for Windows 1.0.0 · 原生 WinUI 3"/>
      <Button Content="安装与升级说明" Click="Updates_Click"/>
      <TextBlock Text="凭据保存在 Windows 凭据管理器中。切换服务地址会停止播放并切换会话。日志不记录密码、令牌或音源链接。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     </StackPanel></ScrollViewer>
     <ScrollViewer x:Name="AccountPanel" Visibility="Collapsed"><StackPanel Spacing="14" MaxWidth="480" HorizontalAlignment="Left">
      <TextBlock x:Name="ProfileText" Text="登录 CurrentMusic，连接你的音乐库。" TextWrapping="Wrap"/>
      <ComboBox x:Name="AuthMode" Header="账号操作" SelectedIndex="0" SelectionChanged="AuthMode_Changed" MinWidth="280"><ComboBoxItem Content="密码登录"/><ComboBoxItem Content="邮箱验证码登录"/><ComboBoxItem Content="注册新账号"/><ComboBoxItem Content="找回密码"/></ComboBox>
      <TextBox x:Name="UsernameBox" Header="用户名 / 已绑定手机号" MinWidth="320"/>
      <TextBox x:Name="ContactBox" Header="邮箱（注册也支持手机号）"/>
      <TextBox x:Name="NicknameBox" Header="昵称（注册）"/>
      <PasswordBox x:Name="PasswordBox" Header="密码 / 新密码"/>
      <TextBox x:Name="CodeBox" Header="验证码"/>
      <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="SubmitAuth" Content="登录" Click="SubmitAuth_Click"/><Button x:Name="SendCode" Content="发送验证码" Click="SendCode_Click"/><Button Content="退出登录" Click="Logout_Click"/></StackPanel>
      <TextBlock Text="网易云绑定" Style="{ThemeResource SubtitleTextBlockStyle}"/>
      <TextBlock x:Name="BindingText" Text="绑定网易云后可使用私人漫游并同步歌单。" TextWrapping="Wrap"/>
      <TextBox x:Name="NcmPhone" Header="网易云手机号"/><TextBox x:Name="NcmCode" Header="网易云短信验证码"/>
      <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="发送短信" Click="NcmCode_Click"/><Button Content="绑定" Click="NcmLogin_Click"/><Button Content="同步歌单" Click="SyncNcm_Click"/></StackPanel>
     </StackPanel></ScrollViewer>
     <Grid x:Name="PlayerPanel" Visibility="Collapsed" ColumnSpacing="32"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Spacing="20"><Image x:Name="PlayerCover" MaxHeight="280" Stretch="Uniform"/><TextBlock x:Name="PlayerTitle" Text="选择一首歌曲开始播放" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap"/><TextBlock x:Name="PlayerArtist" TextWrapping="Wrap"/><TextBlock x:Name="WordLyric" FontSize="22" TextWrapping="Wrap"/><Button Content="桌面歌词" Click="DesktopLyrics_Click"/></StackPanel>
      <ListView Grid.Column="1" x:Name="LyricList" IsItemClickEnabled="True" ItemClick="Lyric_ItemClick" AutomationProperties.Name="歌词，点击跳转"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="8" Spacing="8"><TextBlock Text="{Binding Text}" FontSize="20" TextWrapping="Wrap"/><TextBlock Text="{Binding Translation}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
     </Grid>
    </Grid>
    <StackPanel Grid.Row="3" Spacing="8"><ProgressBar x:Name="Busy" IsIndeterminate="True" Visibility="Collapsed"/><TextBlock x:Name="StatusText" Text="准备就绪" TextWrapping="Wrap"/><InfoBar x:Name="Feedback" IsOpen="False" IsClosable="True"/></StackPanel>
   </Grid>
  </NavigationView>
  <Border Grid.Row="1" Padding="20,10" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
   <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center"><TextBlock x:Name="NowTitle" Text="尚未播放" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="NowArtist" Text="登录后即可聆听" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button AutomationProperties.Name="上一首" Click="Previous_Click"><SymbolIcon Symbol="Previous"/></Button><Button x:Name="PlayButton" AutomationProperties.Name="播放或暂停" Click="Toggle_Click"><SymbolIcon Symbol="Play"/></Button><Button AutomationProperties.Name="下一首" Click="Next_Click"><SymbolIcon Symbol="Next"/></Button></StackPanel>
     <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"><ComboBox x:Name="RepeatPicker" SelectedIndex="0" SelectionChanged="Repeat_Changed" AutomationProperties.Name="循环模式"><ComboBoxItem Content="列表循环"/><ComboBoxItem Content="单曲循环"/><ComboBoxItem Content="随机"/></ComboBox><Slider x:Name="VolumeSlider" Width="96" Minimum="0" Maximum="1" StepFrequency="0.01" SmallChange="0.01" LargeChange="0.1" ValueChanged="Volume_Changed" AutomationProperties.Name="音量"/></StackPanel>
    </Grid>
    <Grid Grid.Row="1" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ElapsedText" Text="0:00" VerticalAlignment="Center"/><Slider Grid.Column="1" x:Name="SeekSlider" Minimum="0" Maximum="1" ValueChanged="Seek_Changed" AutomationProperties.Name="播放进度"/><TextBlock Grid.Column="2" x:Name="DurationText" Text="0:00" VerticalAlignment="Center"/></Grid>
   </Grid>
  </Border>
 </Grid>
</Window>
