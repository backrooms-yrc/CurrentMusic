<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ApplicationVersion>1.0.0</ApplicationVersion>
    <ApplicationIcon>Assets/CurrentMusic.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9457" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
    <ProjectReference Include="../CurrentMusic.Core/CurrentMusic.Core.csproj" />
    <Content Include="Assets/Diagnostics/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Unpackaged MRT Core builds generate the project PRI but SDK 2.6.4 does not
       add it to dotnet publish. See microsoft/WindowsAppSDK#6720. -->
  <Target Name="PublishCurrentMusicPri" BeforeTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="$(GenerateProjectPriFile)">
    <Error Condition="!Exists('$(ProjectPriFullPath)')" Text="The CurrentMusic XAML resource index was not generated." />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)">
        <RelativePath>$(ProjectPriFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
